# ══════════════════════════════════════════════════════
# BUNAI TASK MANAGER — Environment Variables
# Copy this file to .env and fill in your real values.
# ══════════════════════════════════════════════════════

# ── MySQL Database (from Hostinger hPanel → Databases / phpMyAdmin) ──
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=bunai_task_manager
DB_PORT=3306
# Set to "true" only if your MySQL host requires SSL (usually false on Hostinger)
DB_SSL=false

# ── App ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string_min_32_chars
# Your live URL after deploy, e.g. https://app.bunai.com
APP_URL=https://your-domain.com

# ── Google Sheets API (OPTIONAL — only for FMS sync feature) ──
# Leave blank if you don't use the FMS / Google Sheets feature.
# To enable: paste your service-account credentials.json as a single line.
GOOGLE_CREDENTIALS=

# ── Spreadsheet IDs (OPTIONAL — FMS / IMS features) ──
# Every project has its own Google Sheets. Take the ID/GID from the sheet URL:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit#gid=<GID>
# Left blank, that feature's API call will error (the rest of the app is unaffected).
# Any sheet you fill in must be shared with the service account email.
IMS_SS_ID=
SALES_SS_ID=
MERCH_FMS_SHEET_ID=
MERCH_FMS_GID=
# Row where the form starts writing. For a fresh empty sheet 2 is correct (right
# after the header row). Change it to append into an already-populated sheet.
MERCH_FMS_START_ROW=2
MERCH_FMS_22GODAM_START_ROW=2
PROCESS_FMS_START_ROW=2
MERCH_FMS_22GODAM_SHEET_ID=
MERCH_FMS_22GODAM_GID=
PROCESS_FMS_SHEET_ID=
PROCESS_FMS_GID=

# ── WhatsApp Automation (Aumfig) ──
# A message is sent in three situations:
#   1) As soon as a delegation task is assigned  → to the doer
#   2) As soon as a checklist is generated       → a summary of the whole series to the doer
#   3) Every day at 10:00 AM (IST)              → that day's entire checklist in ONE message
# Leaving AUMFIG_API_KEY blank silently disables all of this.
AUMFIG_API_KEY=
AUMFIG_API_URL=https://api.aumfig.com/api/v1/send-message

# How long after a task is assigned/generated the message goes out (milliseconds).
# Default 60000 = 1 minute (the existing delegation behaviour — checklists use it too).
WHATSAPP_DELAY_MS=60000

# Gap between two messages. All messages (delegation + checklist + 10 AM reminder)
# go out one at a time from a single FIFO queue — with a random 4-5 MINUTE gap
# between each (a fixed interval looks bot-like, hence random). The gap is this
# large so WhatsApp/Aumfig do not flag it as spam.
#   To change the range:
WHATSAPP_GAP_MIN_MS=240000        # 4 min
WHATSAPP_GAP_MAX_MS=300000        # 5 min
#   Or uncomment the line below for a fixed gap (the range is then ignored):
# WHATSAPP_GAP_MS=270000          # e.g. exactly 4.5 min

# ── Cron (serverless only) ──
# On Vercel a setInterval cannot survive between requests, so the daily reminder
# is triggered by Vercel Cron calling /api/cron/checklist-reminder. This shared
# secret is what authorises that call (cron has no login session).
CRON_SECRET=generate_with_openssl_rand_hex_24

# ── Daily checklist reminder (10 AM IST) ──
# The timing is always computed in IST, even when the server runs in UTC.
# Set CHECKLIST_REMINDER_ENABLED=0 to turn it off
CHECKLIST_REMINDER_ENABLED=1
CHECKLIST_REMINDER_HOUR=10
CHECKLIST_REMINDER_MINUTE=0

# ── PO Document Upload (OPTIONAL) ──
# Finance uploads PO documents (Tally export / own software) against a PO row —
# files are stored on Google Drive via the same service account above (needs the
# Drive API enabled on the same GCP project as GOOGLE_CREDENTIALS).
# Leave blank to let files land in the service account's own Drive (works out of
# the box). Or create a Drive folder, share it with the service account email as
# "Editor", and paste its folder ID here to keep all PO docs in one place.
PO_DRIVE_FOLDER_ID=
